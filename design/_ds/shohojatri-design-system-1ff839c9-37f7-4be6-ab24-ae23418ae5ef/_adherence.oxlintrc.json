{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/actions/**",
              "components/cards/**",
              "components/chat/**",
              "components/choice/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlay/**",
              "ui_kits/companion/**",
              "ui_kits/screening/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo Da 2|Hind Siliguri))/i]",
        "message": "Font not provided by the design system. Available: Baloo Da 2, Hind Siliguri."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|imageSrc|icon|meta|status|doneLabel|ctaLabel|onStart|lang|key|ref|className|style|children)$/]",
        "message": "<ActivityCard> doesn't accept that prop. Declared props: title, description, imageSrc, icon, meta, status, doneLabel, ctaLabel, onStart, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:todo|done)$/]",
        "message": "<ActivityCard> status must be one of 'todo' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityCard'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:bn|en)$/]",
        "message": "<ActivityCard> lang must be one of 'bn' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|alt|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, alt."
