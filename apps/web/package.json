{
  "name": "shohojatri-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-models.mjs && next dev",
    "build": "node scripts/prepare-models.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/sw",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json --default-non-nullable false -o src/lib/api/schema.d.ts",
    "test:cv": "node --experimental-strip-types --no-warnings --test src/lib/cv/cv.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mediapipe/tasks-audio": "^1.1.1",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "serwist": "9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
