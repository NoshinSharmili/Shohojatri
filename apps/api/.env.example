# development (default) or production. Production refuses to start unless DATABASE_URL is
# Postgres, JWT_SECRET has 32+ characters, OPENAI_API_KEY and OPENAI_MODEL are set and
# PUBLIC_WEB_URL is https; it also forces Secure cookies.
ENV=development
# SQLAlchemy URL. SQLite by default. Postgres: postgresql://user:pass@host:5432/db (postgres:// and
# postgresql:// are switched to the psycopg 3 driver automatically).
DATABASE_URL=sqlite:///./shohojatri.db
# Comma-separated origins allowed to call the API from a browser. In production it defaults to
# PUBLIC_WEB_URL (the browser normally goes through the web app's /api/v1 rewrite anyway).
CORS_ORIGINS=http://localhost:3000
# The web app's public address, e.g. https://shohojatri.vercel.app. Share links and QR codes use
# it. Empty in development: the web app then uses its own origin.
PUBLIC_WEB_URL=
# Signs auth tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty in development, the API uses a random key per start (everyone is logged out on restart).
JWT_SECRET=
# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set to true when served over HTTPS so auth cookies are only sent over TLS (always on in production).
COOKIE_SECURE=false
# OpenAI (all calls go through app/ai/llm.py). Leave the key empty to run without AI: "Other"
# answers then ask the parent to pick the closest option themselves.
OPENAI_API_KEY=
# OpenAI's current lightweight model (checked against developers.openai.com, 2026-10).
OPENAI_MODEL=gpt-6-luna
# reasoning.effort for every call; empty uses the model's default (medium, slower).
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=20
# LLM calls per user per day (Bangladesh time). Past it, AI features fall back. 0 = no cap.
LLM_DAILY_CAP=50
# Abuse protection (0 turns a limit off): login attempts per IP per 15 min, wrong passwords per
# account per 15 min, sign-ups per IP per hour.
LOGIN_ATTEMPTS_PER_IP=30
LOGIN_FAILURES_PER_ACCOUNT=10
SIGNUPS_PER_IP=10
# Container only (scripts/start.sh): load the demo accounts and children on start (idempotent).
SEED_DEMO=false
# Container only: the port to listen on (Render sets it) and the number of uvicorn workers.
PORT=8000
WEB_CONCURRENCY=2
