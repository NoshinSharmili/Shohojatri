# SQLAlchemy URL. SQLite by default; Postgres e.g. postgresql+psycopg://user:pass@localhost:5432/shohojatri
DATABASE_URL=sqlite:///./shohojatri.db
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Signs auth tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, the API uses a random key per start (everyone is logged out on restart).
JWT_SECRET=
# Token lifetimes.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set to true when served over HTTPS so auth cookies are only sent over TLS.
COOKIE_SECURE=false
